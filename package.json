{
  "name": "idf-strike",
  "productName": "IDF Strike",
  "version": "1.0.20",
  "description": "IDF Strike: Gaza",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "server": "node tools/server.mjs",
    "serve": "node tools/serve.mjs 8124",
    "vendor": "node tools/vendor-three.mjs",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.idfstrike.game",
    "productName": "IDF Strike",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "package.json",
      "electron/**",
      "index.html",
      "style.css",
      "src/**",
      "vendor/**",
      "assets/**",
      "!assets/models/_raw/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "B3waR3",
      "repo": "IDF-Strike"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "IDF-Strike-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "IDF Strike",
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "three": "^0.160.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  }
}
